# Rust
target/
# Cargo.lock is committed for reproducible CI: a fresh resolve otherwise pulls
# ed25519-dalek 3.0.0, which fails to compile soroban-env-host's testutils and
# breaks `cargo test`/`clippy` for the whole workspace.
**/*.rs.bk

# Soroban
.soroban/
*.wasm
*.optimized.wasm

# Test artifacts
test_snapshots/
**/test_snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
**/test_snapshots/
